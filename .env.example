# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET="replace-with-generated-secret"
AUTH_TRUST_HOST=true
# Local development only. In production set this to the deployed origin
# (e.g. https://redihealth.vercel.app) or leave it unset so the host is inferred.
AUTH_URL="http://localhost:3000"

# Database connection settings.
# On Supabase, the direct connection host (db.<ref>.supabase.co:5432) is IPv6-only.
# Serverless platforms such as Vercel cannot reach it, so deployments must use the
# IPv4 connection pooler instead:
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL="postgresql://user:password@localhost:5432/redihealth"
DATABASE_SSL=

# Optional Google OAuth credentials.
AUTH_GOOGLE_ID="replace-with-google-client-id"
AUTH_GOOGLE_SECRET="replace-with-google-client-secret"

# Hostinger Mail API settings for one-time email codes.
HOSTINGER_MAIL_API_TOKEN="replace-with-hostinger-api-token"
HOSTINGER_MAIL_FROM="redihealth@miorix.digital"
HOSTINGER_MAIL_DISPLAY_NAME="RediHealth"

# OpenRouter API key for the Health Assistant vision model.
OPENROUTER_API_KEY="replace-with-openrouter-api-key"
# Optional: defaults to GPT-4o mini, a lower-cost multimodal model.
OPENROUTER_MODEL=openai/gpt-4o-mini
