# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET="replace-with-generated-secret"
AUTH_TRUST_HOST=true
# Local development only. In production set this to the deployed origin
# (e.g. https://redihealth.vercel.app) or leave it unset so the host is inferred.
AUTH_URL="http://localhost:3000"

# Database connection settings.
# Use either a MySQL connection URL:
# DATABASE_URL="mysql://user:password@localhost:3306/redihealth"
#
# Or discrete MySQL settings (recommended for local development):
DB_HOST="127.0.0.1"
DB_PORT=3306
DB_USER="root"
DB_PASSWORD=""
DB_NAME="redihealth"
DATABASE_URL=""
DATABASE_URL_PRODUCTION=""
DATABASE_SSL=false

# Optional Google OAuth credentials.
AUTH_GOOGLE_ID="replace-with-google-client-id"
AUTH_GOOGLE_SECRET="replace-with-google-client-secret"

# Hostinger Mail API settings for one-time email codes.
HOSTINGER_MAIL_API_TOKEN="replace-with-hostinger-api-token"
HOSTINGER_MAIL_FROM="redihealth@miorix.digital"
HOSTINGER_MAIL_DISPLAY_NAME="RediHealth"

# AI provider settings for the Health Assistant.
# Provide at least one API key. LLMSRELAY_API_KEY is recommended.
LLMSRELAY_API_KEY="replace-with-llmsrelay-api-key"
ANTHROPIC_API_KEY=""
# Optional model overrides.
LLMSRELAY_MODEL=claude-haiku-4.5
ANTHROPIC_MODEL=claude-haiku-4.5
# Optional base URL for Anthropic-compatible endpoints.
ANTHROPIC_BASE_URL="https://api.llmsrelay.com"
