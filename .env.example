# --- Authentication --------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""
# Public origin of the site. Used for links in emails and in sitemap.xml/robots.txt.
AUTH_URL="http://localhost:3000"
# Set to true when running behind your own proxy/hostname in production.
AUTH_TRUST_HOST=true
# Optional Google sign-in.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Bot protection (Google reCAPTCHA v3, not v2 checkbox keys) --------------
# Disabled for now. Enable only after configuring all three variables below.
RECAPTCHA_ENABLED=false
# Create a v3 site at https://www.google.com/recaptcha/admin/create.
# The site key is public and embedded at build time; rebuild after changing it.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""
# Server-only secret. Never prefix this variable with NEXT_PUBLIC_.
RECAPTCHA_SECRET_KEY=""
# Exact hostnames, without protocols, paths, or ports. Include localhost for development.
RECAPTCHA_ALLOWED_HOSTNAMES="localhost,127.0.0.1"

# --- Reverse proxy ---------------------------------------------------------
# Set to true only when a trusted reverse proxy (nginx, Caddy, a CDN) overwrites X-Forwarded-For.
# Without it every visitor shares one rate-limit bucket. Not needed on Vercel.
REDIHEALTH_TRUST_PROXY_HEADERS=false

# --- Databases (MySQL) -----------------------------------------------------
# Control database: nothing personal. Rate limits, settings and the institute directory.
# Use a connection URL ...
# DATABASE_URL="mysql://user:password@host:3306/redihealth_control"
# ... or discrete settings.
DB_HOST="127.0.0.1"
DB_PORT=3306
DB_USER="root"
DB_PASSWORD=""
DB_NAME="redihealth"

# One database per country, each with its own credentials. Countries: RO, AL, IT, MD.
# A country without settings is simply not available. Either a URL ...
# DATABASE_URL_RO="mysql://ro_user:password@host:3306/redihealth_ro"
# ... or DB_<CC>_HOST / DB_<CC>_PORT / DB_<CC>_USER / DB_<CC>_PASSWORD / DB_<CC>_NAME.
# DB_MD_HOST="127.0.0.1"
#
# Installations that still use one database: its data belongs to this country until
# DATABASE_URL_<CC> is set for it.
DEFAULT_COUNTRY="RO"

# Pool size per database and server process.
DB_CONNECTION_LIMIT=10
# TLS to the databases. Certificates are verified; supply DATABASE_SSL_CA (PEM, \n-escaped) for private CAs.
DATABASE_SSL=false
DATABASE_SSL_CA=""
# DATABASE_SSL_REJECT_UNAUTHORIZED=false   # only for self-signed development servers

# --- Field encryption ------------------------------------------------------
# One 32-byte key per country (medical history and photos are encrypted with it).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep each key out of the database backups of its country.
# DATA_ENCRYPTION_KEY_RO=""
# DATA_ENCRYPTION_KEY_AL=""
# DATA_ENCRYPTION_KEY_IT=""
# DATA_ENCRYPTION_KEY_MD=""

# --- Email (Hostinger Mail API) --------------------------------------------
HOSTINGER_MAIL_API_TOKEN=""
HOSTINGER_MAIL_FROM=""
HOSTINGER_MAIL_DISPLAY_NAME="RediHealth"
# Fallback recipient for issue reports and operational alerts.
# Super admins can set the recipient in the panel (Settings), which takes precedence.
OPERATIONAL_ALERT_EMAIL=""
# Public origin used in email links when it differs from AUTH_URL.
APP_URL=""

# --- AI assistant and transcription ----------------------------------------
# Provide at least one API key. LLMSRELAY_API_KEY is recommended.
LLMSRELAY_API_KEY=""
ANTHROPIC_API_KEY=""
LLMSRELAY_MODEL="claude-haiku-4.5"
ANTHROPIC_MODEL=""
LLMSRELAY_BASE_URL="https://api.llmsrelay.com"
ANTHROPIC_BASE_URL="https://api.llmsrelay.com"
LLMSRELAY_TRANSCRIPTION_MODEL="whisper-1"

# --- Video meetings --------------------------------------------------------
JITSI_DOMAIN="meet.jit.si"

# --- Monitoring ------------------------------------------------------------
# Bearer token for detailed output from GET /api/health (the public response only contains the status).
HEALTH_CHECK_TOKEN=""

# --- Development -----------------------------------------------------------
# Comma-separated LAN hosts allowed to load the dev server, e.g. 192.168.0.61
DEV_ALLOWED_ORIGINS=""
