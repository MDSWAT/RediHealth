# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# MySQL connection string for application data.
DATABASE_URL="mysql://root:password@localhost:3306/redihealth"
DATABASE_SSL=false

# Optional Google OAuth credentials.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Hostinger Mail API settings for one-time email codes.
HOSTINGER_MAIL_API_TOKEN=
HOSTINGER_MAIL_FROM="noreply@example.com"
HOSTINGER_MAIL_DISPLAY_NAME="RediHealth"
