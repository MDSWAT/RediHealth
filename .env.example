# --- Vercel setup ----------------------------------------------------------
# Vercel > your project > Settings > Environment Variables.
# Add the names below with your real values (paste values WITHOUT surrounding quotes).
# Select Production; use separate keys/hostnames for Preview and Development.
# Required for this change: ANTHROPIC_API_KEY, ANTHROPIC_MODEL, RECAPTCHA_ENABLED,
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY, RECAPTCHA_SECRET_KEY, RECAPTCHA_ALLOWED_HOSTNAMES.
# Also keep your existing database, authentication, encryption and email settings.
# Save, then Deployments > latest deployment > Redeploy. Changes do not affect old deployments.
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY is embedded at build time: a new build is required.
# Never put API keys, database passwords or CAPTCHA secrets in NEXT_PUBLIC_ variables.
# This file is an EXAMPLE, not a working deployment: empty secrets must be supplied.
# For local development, copy to .env.local, use http://localhost:3000 for AUTH_URL
# and APP_URL, and set RECAPTCHA_ENABLED=false or register localhost with Google.

# --- Authentication --------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""
# Public origin of the site. Used for links in emails and in sitemap.xml/robots.txt.
AUTH_URL="https://redi-health.vercel.app"
# Set to true when running behind your own proxy/hostname in production.
AUTH_TRUST_HOST=true
# Optional Google sign-in.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Bot protection (Google reCAPTCHA v3, not v2 checkbox keys) --------------
# Enabled in production by default. Explicit false disables protection (local development).
# Configure the site key, secret and allowed hostnames before deploying with true.
# Missing server configuration fails closed: protected forms will reject submissions.
RECAPTCHA_ENABLED=true
# Create a reCAPTCHA v3 (score-based) site at https://www.google.com/recaptcha/admin/create.
# Add redi-health.vercel.app and any custom domain there. Keep domain validation enabled.
# Use a v3 site key + matching SECRET KEY, not a Google API key or v2 checkbox keys.
# The site key is public and embedded at build time; rebuild after changing it.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""
# Server-only secret. Never prefix this variable with NEXT_PUBLIC_.
RECAPTCHA_SECRET_KEY=""
# Exact hostnames, without https://, paths, ports or wildcards; comma-separated.
# Add your custom domain here AND in Google's allowed domains if you use one.
# For preview, add the exact stable preview hostname in both places with matching keys.
RECAPTCHA_ALLOWED_HOSTNAMES="redi-health.vercel.app"

# --- Reverse proxy ---------------------------------------------------------
# Set to true only when a trusted reverse proxy (nginx, Caddy, a CDN) overwrites X-Forwarded-For.
# Without it every visitor shares one rate-limit bucket. Not needed on Vercel.
REDIHEALTH_TRUST_PROXY_HEADERS=false

# --- Databases (MySQL) -----------------------------------------------------
# Control database: nothing personal. Rate limits, settings and the institute directory.
# Vercel needs a reachable hosted MySQL server; 127.0.0.1 below is local development only.
# Prefer DATABASE_URL and country URLs in Vercel; enable verified TLS as your host requires.
# Use a connection URL ...
# DATABASE_URL="mysql://user:password@host:3306/redihealth_control"
# ... or discrete settings.
DB_HOST="127.0.0.1"
DB_PORT=3306
DB_USER="root"
DB_PASSWORD=""
DB_NAME="redihealth"

# One database per country, each with its own credentials. Countries: RO, AL, IT, MD.
# A country without settings is simply not available. Either a URL ...
# DATABASE_URL_RO="mysql://ro_user:password@host:3306/redihealth_ro"
# ... or DB_<CC>_HOST / DB_<CC>_PORT / DB_<CC>_USER / DB_<CC>_PASSWORD / DB_<CC>_NAME.
# DB_MD_HOST="127.0.0.1"
#
# Installations that still use one database: its data belongs to this country until
# DATABASE_URL_<CC> is set for it.
DEFAULT_COUNTRY="RO"

# Pool size per database and server process.
DB_CONNECTION_LIMIT=10
# TLS to the databases. Certificates are verified; supply DATABASE_SSL_CA (PEM, \n-escaped) for private CAs.
DATABASE_SSL=false
DATABASE_SSL_CA=""
# DATABASE_SSL_REJECT_UNAUTHORIZED=false   # only for self-signed development servers

# --- Field encryption ------------------------------------------------------
# One 32-byte key per country (medical history and photos are encrypted with it).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep each key out of the database backups of its country.
# DATA_ENCRYPTION_KEY_RO=""
# DATA_ENCRYPTION_KEY_AL=""
# DATA_ENCRYPTION_KEY_IT=""
# DATA_ENCRYPTION_KEY_MD=""

# --- Email (Hostinger Mail API) --------------------------------------------
HOSTINGER_MAIL_API_TOKEN=""
HOSTINGER_MAIL_FROM=""
HOSTINGER_MAIL_DISPLAY_NAME="RediHealth"
# Fallback recipient for issue reports and operational alerts.
# Super admins can set the recipient in the panel (Settings), which takes precedence.
OPERATIONAL_ALERT_EMAIL=""
# Public origin used in email links when it differs from AUTH_URL.
APP_URL="https://redi-health.vercel.app"

# --- AI assistant (direct Anthropic / Claude API) ---------------------------
# Create an Anthropic API key in https://platform.claude.com/ and fund API usage.
# A Claude chat subscription is not an API key. Keep this value server-only in Vercel.
# Chat, medical image/prescription review and summaries call api.anthropic.com directly.
# Legacy LLMSRELAY_MODEL / ANTHROPIC_BASE_URL do not control the AI assistant anymore.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-haiku-4-5-20251001"
# Use an exact supported Claude model ID, not the old relay alias claude-haiku-4.5.
# Model reference: https://platform.claude.com/docs/en/about-claude/models/overview

# --- Optional meeting audio transcription (separate from Claude) -----------
# These settings are used ONLY by meeting audio transcription, not the AI assistant.
# Leave empty if you do not use that feature. Claude's text/image API is not the
# relay's Whisper transcription endpoint; an Anthropic key cannot be used here.
LLMSRELAY_API_KEY=""
LLMSRELAY_BASE_URL="https://api.llmsrelay.com"
LLMSRELAY_TRANSCRIPTION_MODEL="whisper-1"

# --- Optional neural text-to-speech (Azure AI Speech + Cloudflare R2) ------
# Server-only Azure Speech F0 credentials. Leave empty to use browser Web Speech
# and pre-recorded clips without neural synthesis.
AZURE_SPEECH_KEY=""
AZURE_SPEECH_KEY_SECONDARY=""
AZURE_SPEECH_REGION=""
# Optional per-language neural voice overrides:
# AZURE_SPEECH_VOICE_RO="ro-RO-AlinaNeural"
# AZURE_SPEECH_VOICE_EN="en-GB-SoniaNeural"
# AZURE_SPEECH_VOICE_SQ="sq-AL-AnilaNeural"
# AZURE_SPEECH_VOICE_IT="it-IT-ElsaNeural"
# AZURE_SPEECH_VOICE_HR="hr-HR-GabrijelaNeural"
# AZURE_SPEECH_VOICE_RU="ru-RU-SvetlanaNeural"
# Optional Cloudflare R2 S3-compatible cache for synthesized MP3 files.
TTS_R2_ACCOUNT_ID=""
TTS_R2_ACCESS_KEY_ID=""
TTS_R2_SECRET_ACCESS_KEY=""
TTS_R2_BUCKET=""
# Optional public HTTPS origin for cached MP3 files (must include https://).
# When set, CSP connect-src/media-src allow this origin and /api/tts returns direct URLs.
TTS_PUBLIC_BASE_URL=""

# --- Video meetings --------------------------------------------------------
JITSI_DOMAIN="meet.jit.si"

# --- Monitoring ------------------------------------------------------------
# Bearer token for detailed output from GET /api/health (the public response only contains the status).
HEALTH_CHECK_TOKEN=""

# --- Development -----------------------------------------------------------
# Comma-separated LAN hosts allowed to load the dev server, e.g. 192.168.0.61
DEV_ALLOWED_ORIGINS=""
