    {
      "name": "Panel save action",
      "kind": "button",
      "refersTo": "panel-button-action",
      "description": "Existing inbox save action; the overview create action continues to use the shared Button component.",
      "html": "<button class=\"ds-panel-save\">Save changes</button>",
      "css": ".ds-panel-save{font-family:var(--font-body,Arial),sans-serif;font-size:13px;min-height:44px;padding:8px 12px;border:1px solid var(--color-sapphire,#1d3557);border-radius:8px;background:var(--color-sapphire,#1d3557);color:white;font-weight:500;cursor:pointer;transition:background-color 160ms cubic-bezier(.25,1,.5,1)}.ds-panel-save:hover{background:#28476f}.ds-panel-save:focus-visible{outline:2px solid var(--color-sapphire,#1d3557);outline-offset:2px;}@media(prefers-reduced-motion:reduce){.ds-panel-save{transition:none}}"
    },
    {
      "name": "Panel outline action",
      "kind": "button",
      "refersTo": "panel-button-outline",
