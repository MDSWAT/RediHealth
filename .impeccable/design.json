      "html": "<label class=\"ds-panel-search\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><circle cx=\"11\" cy=\"11\" r=\"7\"/><path d=\"m16 16 4 4\"/></svg><input type=\"search\" aria-label=\"Search requests\" placeholder=\"Search requests\"></label>",
      "css": ".ds-panel-search{display:flex;align-items:center;gap:8px;width:240px;max-width:100%;padding-left:12px;border:1px solid #8a94a6;border-radius:8px;background:#fff;color:#58697c}.ds-panel-search input{font-family:var(--font-body,Arial),sans-serif;font-size:13px;min-height:44px;min-width:0;width:100%;border:0;background:transparent;color:#172b43;padding:9px 11px 9px 0;outline:none;font-size:14px}.ds-panel-search input::placeholder{color:#58697c;opacity:1}.ds-panel-search:focus-within{outline:2px solid #1d3557;outline-offset:2px}"
    },
