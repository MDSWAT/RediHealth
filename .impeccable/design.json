      "css": ".ds-panel-outline{font-family:var(--font-body,Arial),sans-serif;font-size:13px;min-height:44px;padding:8px 12px;border:1px solid #8a94a6;border-radius:8px;background:#fff;color:#172b43;font-weight:500;cursor:pointer}.ds-panel-outline:hover{background:#edf3f9}.ds-panel-outline[aria-expanded=\"true\"]{background:#edf3f9;border-color:#1d3557}.ds-panel-outline:focus-visible{outline:2px solid var(--color-sapphire,#1d3557);outline-offset:2px;}.ds-panel-outline:disabled{color:#58697c;border-color:#dde4eb;background:#f8fafb;cursor:default}"
    },
