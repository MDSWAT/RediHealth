{
  "name": "health-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "tunnel": "cloudflared tunnel --url http://localhost:3000",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "tsx --env-file=.env.local scripts/migrate.ts",
    "import:institutes": "tsx scripts/import-medical-institutes.ts",
    "encrypt:patients": "tsx scripts/encrypt-patient-data.ts",
    "romani:export": "tsx scripts/romani-catalog.ts export",
    "romani:check": "tsx scripts/romani-catalog.ts check",
    "romani:import": "tsx scripts/romani-catalog.ts import",
    "health:inventory": "tsx scripts/health-content/inventory.ts",
    "health:generate": "tsx scripts/health-content/generate.ts",
    "health:assemble": "tsx scripts/health-content/assemble.ts",
    "health:audit": "tsx scripts/health-content/audit.ts",
    "health:register-direct": "tsx scripts/health-content/register-direct.ts"
  },
  "dependencies": {
    "@types/three": "^0.187.0",
    "hostinger-mail-api-sdk": "^1.19.0",
    "jose": "^6.2.10",
    "leaflet": "^1.9.4",
    "lottie-web": "^5.13.0",
    "motion": "^14.10.1",
    "mysql2": "^3.24.3",
    "next": "16.4.1",
    "next-auth": "^5.0.0-beta.32",
    "react": "19.2.8",
    "react-body-highlighter": "^2.0.5",
    "react-dom": "19.2.8",
    "react-leaflet": "^5.0.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  }
}
