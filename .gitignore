# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env.*
.env*
!.env.example

# vercel
.vercel

# typescript & build caches
*.tsbuildinfo
next-env.d.ts
.turbo

# local agent & audit artifacts
.agents
.agents/
.claude/
/docs
PROJECT.md
playwright-report/
test-results/
*.log

# Piper voice tooling (scripts/health-check-voice)
.piper-venv/
.piper-voices/
.piper-espeak/

# Local source/review cache for health article authoring (never served)
.health-content-cache/
